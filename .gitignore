# Artefactos de PyInstaller (se regeneran con `python -m PyInstaller app/GUI_Watermark.spec`)
build/
dist/

# Bytecode de Python
__pycache__/
*.pyc

# Salida de graphify (grafo generado, no es código fuente del proyecto)
graphify-out/

# Clave privada de activación (Ed25519): NUNCA debe subirse al repo.
# Solo debe existir en la máquina de Recicley-TI que emite códigos de
# reactivación. Ver admin_tools/generate_keypair.py.
admin_tools/*.pem
admin_tools/private_key.pem

# .exe del generador de códigos de activación: es un build local para la
# máquina de soporte de Recicley-TI, no un artefacto del proyecto (igual
# que build/ y dist/ para la app principal). Se reconstruye con
# admin_tools/generate_unlock_code.spec.
admin_tools/*.exe
admin_tools/build/
admin_tools/dist/
